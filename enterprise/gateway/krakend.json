      ],
      "output_encoding": "no-op",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_local_path": "/run/jwt/jwks.json",
          "issuer": "https://api.laporaman.local",
          "audience": [
            "laporaman-operator"
          ],
          "roles_key": "roles",
