{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "laporaman-enterprise-gateway",
  "port": 8080,
  "timeout": "15s",
  "cache_ttl": "0s",
  "output_encoding": "no-op",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "http://localhost:8080"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PATCH",
        "OPTIONS"
      ],
      "allow_headers": [
        "Authorization",
        "Content-Type",
        "X-Request-ID"
      ],
      "expose_headers": [
        "X-Request-ID"
      ],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/health",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://api:8000"
          ],
          "url_pattern": "/api/health",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "client_max_rate": 8,
          "client_capacity": 1,
          "every": "10s",
          "strategy": "ip"
        }
      }
    },
    {
      "endpoint": "/api/v2/auth/token",
      "method": "POST",
      "input_headers": [
        "Content-Type",
        "X-Request-ID"
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "client_max_rate": 8,
          "client_capacity": 1,
          "every": "10s",
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "host": [
            "http://api:8000"
          ],
          "url_pattern": "/api/v2/auth/token",
          "method": "POST",
          "encoding": "no-op"
        }
      ]
    },
    {
