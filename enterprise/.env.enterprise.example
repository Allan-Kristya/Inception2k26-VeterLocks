# Copy to enterprise/.env (do not commit actual secrets).
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
POSTGRES_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_PASSWORD
JWT_TTL_MINUTES=10
WEBHOOK_ENCRYPTION_KEY=REPLACE_WITH_44_CHAR_FERNET_KEY
# Explicit allowlist, comma-separated DNS names. Empty means block all outbound webhooks.
WEBHOOK_ALLOWED_HOSTS=
DEFAULT_SLA_HOURS=24
WORKER_INTERVAL_SECONDS=2
GATEWAY_BIND=127.0.0.1
CORS_ORIGINS=http://localhost:8080
AI_INSTALL_ML=0
AI_SERVICE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_SERVICE_TOKEN
AI_LABEL_MAP_JSON={}
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
