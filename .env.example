# Ganti semua secret/password sebelum deployment bersama atau produksi. Gunakan karakter URL-safe untuk password database.
POSTGRES_ADMIN_PASSWORD=ChangeThisPostgresAdminPassword
POSTGRES_APP_PASSWORD=ChangeThisRuntimeDbPassword
JWT_SECRET=ChangeThisJWTSecretWithAtLeast32RandomCharacters
APP_ENCRYPTION_KEY=ChangeThisWebhookEncryptionSecret
BOOTSTRAP_PASSWORD=ChangeThisDemoPasswordAtLeast12Chars
SEED_DEMO_USERS=true
ACCESS_TOKEN_MINUTES=60
LOG_LEVEL=INFO
APP_ENV=development
